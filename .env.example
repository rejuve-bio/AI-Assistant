# LLM Configuration
# For lighter tasks 
BASIC_LLM_PROVIDER=openai
BASIC_LLM_VERSION=gpt-3.5-turbo

# For complex tasks
ADVANCED_LLM_PROVIDER=openai
ADVANCED_LLM_VERSION=gpt-4o

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here




# Hypothesis API Endpoints (Mock Services)
HYPOTHESIS_CHAT_ENDPOINT=http://localhost:9001/api/mock/hypothesis/chat # Endpoint used to retrieve existing hypotheses and their details by ID.
HYPOTHESIS_MAIN_ENDPOINT=http://localhost:9001/api/mock/hypothesis/main # Endpoint for checking generation status (polling) and triggering the final hypothesis creation.
HYPOTHESIS_DATA_API=http://localhost:9001/api/mock/hypothesis      # Endpoint for starting the data enrichment process and fetching intermediate results.




# ── Neo4j credentials (SERVER-SIDE ONLY — NOT needed by the app container) ────
# These are used ONLY by helper/export_neo4j_to_parquet.py which runs on the
# server to generate parquet files. The app itself never connects to Neo4j.
# Keep these in a separate .env on the server, NOT in the app's .env.
#
# NEO4J_URI=bolt://your-neo4j-host:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your_password

# Authentication
JWT_SECRET=your_jwt_secret_here


# Flask Configuration
FLASK_PORT=5002

# Qdrant Configuration
QDRANT_CLIENT=http://localhost:6333

# Embedding Configuration
EMBEDDING_MODEL=gemini
VECTOR_COLLECTION=SITE_INFORMATION_gemini

# MongoDB Configuration
MONGO_USERNAME=admin
MONGO_PASSWORD=your_mongodb_password_here
MONGO_DATABASE=ai_assistant
MONGO_URL=mongodb://admin:your_mongodb_password_here@mongodb:27017/

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

ANNOTATION_SERVICE_URL=http://your-annotation-service

# Galaxy MCP Server Configuration
GALAXY_MCP_SERVER=http://

# bioGPT Configuration
BIOGPT_THREADS=1

# Biomni Data Lake — path to local parquet files for offline DB access
# Run helper/download_biomni_data.py once to populate this directory.
# If not set, all data_lake functions fall back to live REST APIs automatically.
BIOMNI_DATA_LAKE=/data/biomni

# Code executor data mode
# "external" (default) — generated scripts use Biomni external API tools
# "neo4j"              — generated scripts use Rejuve Neo4j parquet exports
#                        Requires neo4j_*.parquet files in BIOMNI_DATA_LAKE
#                        Run helper/export_neo4j_to_parquet.py to generate them
CODING_DATA_MODE=external
