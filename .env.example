# ==========================================
# LLM Configuration
# ==========================================
# For lighter tasks 
BASIC_LLM_PROVIDER=openai  # 'openai' or 'gemini'
BASIC_LLM_VERSION=gpt-3.5-turbo  # 'gpt-3.5-turbo', 'gemini-lite', etc.

# For complex, resource-intensive tasks
ADVANCED_LLM_PROVIDER=openai  # 'openai' or 'gemini'
ADVANCED_LLM_VERSION=gpt-4o  # 'gpt-4o', 'gemini-pro', etc.

# ==========================================
# API Keys
# ==========================================
OPENAI_API_KEY=<your openai api key>
GEMINI_API_KEY=<your gemini api key>

# ==========================================
# Authentication
# ==========================================
JWT_SECRET=<jwt_secret_here>

# ==========================================
# Application Settings
# ==========================================
FLASK_PORT=5002
BIOGPT_THREADS=1  # Number of CPU threads for BioGPT inference

# ==========================================
# LangSmith (Tracing & Observability)
# ==========================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=<your_langsmith_api_key>
LANGCHAIN_PROJECT=rejuv-ai-assistant
# Optional privacy controls
# LANGCHAIN_HIDE_INPUTS=true
# LANGCHAIN_HIDE_OUTPUTS=true

# ==========================================
# Database & Vector Store Configuration
# ==========================================
# Qdrant
QDRANT_CLIENT=http://localhost:6333

# Embedding Configuration
# In __init__.py, you may need to change the embedding_model variable to:
# - openai_embedding_model
# - gemini_embedding_model
# - sentence_transformer_embedding_model
EMBEDDING_MODEL=gemini 
VECTOR_COLLECTION=SITE_INFORMATION_gemini

# MongoDB
MONGO_USERNAME=admin
MONGO_PASSWORD=<your_mongodb_password>
MONGO_DATABASE=ai_assistant
MONGO_URL=mongodb://admin:<your_mongodb_password>@mongodb:27017/

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Neo4j Graph Database
NEO4J_URI=<neo4j_uri>
NEO4J_USERNAME=<neo4j_username>
NEO4J_PASSWORD=<neo4j_password>

# ==========================================
# Specialized Services
# ==========================================
ANNOTATION_SERVICE_URL=http://localhost:8080
# Alternate Annotation Service URL example: 
# ANNOTATION_SERVICE_URL=http://localhost:5000/query?limit=100&properties=true

GALAXY_MCP_SERVER=http://localhost:xxxx
