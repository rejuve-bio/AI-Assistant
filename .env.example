# For lighter tasks 
BASIC_LLM_PROVIDER=openai  # 'openai', 'gemini', or 'groq'
BASIC_LLM_VERSION=gpt-3.5-turbo  # 'gpt-3.5-turbo', 'gemini-lite', 'llama-3.3-70b-versatile', etc.

# For complex, resource-intensive tasks
ADVANCED_LLM_PROVIDER=openai  # 'openai', 'gemini', or 'groq'
ADVANCED_LLM_VERSION=gpt-4o  # 'gpt-4o', 'gemini-pro', 'llama-3.3-70b-versatile', etc.

# API keys for each provider
OPENAI_API_KEY=<your openai api key>
GEMINI_API_KEY=<your gemini api key>
GROQ_API_KEY=<your groq api key>

NEO4J_URI=<neo4j uri>
NEO4J_USERNAME=<neo4j username>
NEO4J_PASSWORD=<neo4j password>

JWT_SECRET=<jwt token used for authentication service>
ANNOTATION_SERVICE_URL=<http://localhost:5000/query?limit=100 & properties=true>
FLASK_PORT=5002

QDRANT_CLIENT=http://localhost:6333

- in __init__.py, Change the embedding_model variable to:
    - openai_embedding_model to use openai embedding models
    - gemini_embedding_model to use gemini embedding models
    - sentence_transformer_embedding_model to use sentence transformer embedding

MONGO_USERNAME=admin
MONGO_PASSWORD=<your_password_here>
MONGO_DATABASE=ai_assistant
MONGO_URL=mongodb://admin:<your_password_here>@mongodb:27017/





# Hypothesis API Endpoints (Mock Services)
HYPOTHESIS_CHAT_ENDPOINT=http://172.17.0.1:9001/api/mock/hypothesis/chat # Endpoint used to retrieve existing hypotheses and their details by ID.
HYPOTHESIS_MAIN_ENDPOINT=http://172.17.0.1:9001/api/mock/hypothesis/main # Endpoint for checking generation status (polling) and triggering the final hypothesis creation.
HYPOTHESIS_DATA_API=http://172.17.0.1:9001/api/mock/hypothesis      # Endpoint for starting the data enrichment process and fetching intermediate results.

# --- BioGPT Service ---
# URL for the BioGPT inference server
BIOGPT_SERVICE_URL=<your_biogpt_service_url>
# Timeout for BioGPT API calls (default 30)
BIOGPT_API_TIMEOUT=100

# --- Clinical Trial Matcher ---
# URL for the ClinicalTrials.gov API (v2)
CLINICAL_TRIALS_API_URL=https://clinicaltrials.gov/api/v2/studies
