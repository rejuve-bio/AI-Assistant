# LLM Configuration
BASIC_LLM_PROVIDER=openai
BASIC_LLM_VERSION=gpt-3.5-turbo

ADVANCED_LLM_PROVIDER=openai
ADVANCED_LLM_VERSION=gpt-4o

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Authentication
JWT_SECRET=your_jwt_secret_here

# LangSmith (Tracing & Observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_real_key_here
LANGCHAIN_PROJECT=rejuv-ai-assistant

# Flask Configuration
FLASK_PORT=5002

# Database & Vector Store Configuration
QDRANT_CLIENT=http://localhost:6333
EMBEDDING_MODEL=gemini
VECTOR_COLLECTION=SITE_INFORMATION_gemini

# MongoDB Configuration
MONGO_USERNAME=admin
MONGO_PASSWORD=your_mongodb_password_here
MONGO_DATABASE=ai_assistant
MONGO_URL=mongodb://admin:your_mongodb_password_here@mongodb:27017/

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Neo4j Graph Database
NEO4J_URI=your_neo4j_uri_here
NEO4J_USERNAME=your_neo4j_username_here
NEO4J_PASSWORD=your_neo4j_password_here

# Specialized Services
ANNOTATION_SERVICE_URL=http://localhost:8080
GALAXY_MCP_SERVER=http://localhost:xxxx
BIOGPT_THREADS=1